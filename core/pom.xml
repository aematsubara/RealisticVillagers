<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>realisticvillagers-core</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>me.matsubara</groupId>
        <artifactId>realisticvillagers-parent</artifactId>
        <version>4.0.1</version>
    </parent>

    <pluginRepositories>
        <pluginRepository>
            <id>maven-snapshots</id>
            <url>https://repository.apache.org/content/repositories/snapshots/</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.4-SNAPSHOT</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>net.wesjd.anvilgui</pattern>
                                    <shadedPattern>me.matsubara.realisticvillagers.util.anvilgui</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.tchristofferson.configupdater</pattern>
                                    <shadedPattern>me.matsubara.realisticvillagers.util.configupdater</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.jsoup</pattern>
                                    <shadedPattern>me.matsubara.realisticvillagers.util.jsoup</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.mineskin</pattern>
                                    <shadedPattern>me.matsubara.realisticvillagers.util.mineskin</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.cryptomorin.xseries</pattern>
                                    <shadedPattern>me.matsubara.realisticvillagers.util.xseries</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>me.matsubara.realisticvillagers.util.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.github.cryptomorin:XSeries</artifact>
                                    <includes>
                                        <include>com/cryptomorin/xseries/base/**</include>
                                        <include>com/cryptomorin/xseries/reflection/**</include>
                                        <include>com/cryptomorin/xseries/particles/**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>net.wesjd:anvilgui</artifact>
                                    <excludes>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper26_R1*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_7*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_8*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_9*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_10*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_11*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_12*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_13*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_14*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_15*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_16*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_17*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_18_R1*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_19_R1*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_19_R2*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_20_R1*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_20_R2*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/Wrapper1_20_R3*</exclude>
                                        <exclude>net/wesjd/anvilgui/version/special/*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <!--
                Binary resources are copied byte for byte. Filtering runs every resource through
                a text decoder to substitute ${...} placeholders, which a schematic is not, and
                the build dies decoding it as UTF-8.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>**/*.schem</include>
                    <include>**/*.nbt</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>**/*.schem</exclude>
                    <exclude>**/*.nbt</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <repositories>
        <!-- Spigot -->
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- Sonatype -->
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>sonatype-snapshots</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots/</url>
        </repository>
        <!-- AnvilGUI -->
        <repository>
            <id>mvn-wesjd-net</id>
            <url>https://mvn.wesjd.net/</url>
        </repository>
        <!-- CodeMC (bStats, PacketEvents) -->
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <repository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </repository>
        <!-- Mojang (authlib) -->
        <repository>
            <id>minecraft-repo</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <!-- JitPack (XSeries, VTL, MineskinClient, Config-Updater, EliteMobs) -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <!-- ViaVersion -->
        <repository>
            <id>viaversion-repo</id>
            <url>https://repo.viaversion.com</url>
        </repository>
        <!-- OpenCollab (PacketEvents snapshots) -->
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
        </repository>
        <repository>
            <id>opencollab-releases</id>
            <url>https://repo.opencollab.dev/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- SpigotAPI -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.21.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- AnvilGUI -->
        <dependency>
            <groupId>net.wesjd</groupId>
            <artifactId>anvilgui</artifactId>
            <version>1.10.13-SNAPSHOT</version>
        </dependency>
        <!-- ConfigUpdater (local module) -->
        <dependency>
            <groupId>com.tchristofferson</groupId>
            <artifactId>ConfigUpdater</artifactId>
            <version>2.2-SNAPSHOT</version>
        </dependency>
        <!-- Authlib -->
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>3.17.30</version>
            <scope>provided</scope>
        </dependency>
        <!-- Mineskin -->
        <dependency>
            <groupId>com.github.aematsubara</groupId>
            <artifactId>MineskinClient</artifactId>
            <!--suppress MavenModelInspection -->
            <version>master-SNAPSHOT</version>
        </dependency>
        <!-- EliteMobs (local lib) -->
        <dependency>
            <groupId>com.magmaguy</groupId>
            <artifactId>EliteMobs</artifactId>
            <version>8.4.2</version>
            <scope>system</scope>
            <systemPath>${maven.multiModuleProjectDirectory}/libs/EliteMobs.jar</systemPath>
        </dependency>
        <!-- ValhallaMMO (local lib, premium) -->
        <dependency>
            <groupId>me.athlaeos</groupId>
            <artifactId>ValhallaMMO</artifactId>
            <version>1.14.1</version>
            <scope>system</scope>
            <systemPath>${maven.multiModuleProjectDirectory}/libs/ValhallaMMO_premium_1.14.1.jar</systemPath>
        </dependency>
        <!-- VTL -->
        <dependency>
            <groupId>com.github.PretzelJohn</groupId>
            <artifactId>VillagerTradeLimiter</artifactId>
            <version>1.5.6</version>
            <scope>provided</scope>
        </dependency>
        <!-- ViaVersion -->
        <dependency>
            <groupId>com.viaversion</groupId>
            <artifactId>viaversion-api</artifactId>
            <version>4.7.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- XSeries 13.7.0 â€” adds MC 26.x (unversioned CraftBukkit) support -->
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
            <version>13.7.0</version>
        </dependency>
        <!-- PacketEvents (local lib) -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.13.0</version>
            <scope>system</scope>
            <systemPath>${maven.multiModuleProjectDirectory}/libs/packetevents-spigot-2.13.0.jar</systemPath>
        </dependency>
        <!-- MorePersistentDataTypes -->
        <dependency>
            <groupId>com.jeff-media</groupId>
            <artifactId>MorePersistentDataTypes</artifactId>
            <version>2.4.0</version>
        </dependency>
        <!-- bStats -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.1.0</version>
        </dependency>
    </dependencies>
</project>

